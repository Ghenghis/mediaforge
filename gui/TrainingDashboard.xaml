<Window x:Class="TrainingDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Training Dashboard - Real-Time Stats" 
        Height="900" Width="1400"
        Background="#1a1a2e" Foreground="White"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Dark Theme Styles -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00ff88"/>
        </Style>
        
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        
        <Style x:Key="ProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#00ff88"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#0f3460" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧠 AI Training Dashboard" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#00ff88" CornerRadius="4" Padding="8,4" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadge" Text="RUNNING" FontSize="12" FontWeight="Bold" Foreground="#1a1a2e"/>
                    </Border>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="ClockText" Text="16:08:05" FontSize="18" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="⚙️ Settings" Padding="15,8" Background="#e94560" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Top Stats Row -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Current Epoch -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="📈" FontSize="20"/>
                    <TextBlock x:Name="EpochValue" Text="3/30" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Current Epoch" Style="{StaticResource StatLabel}"/>
                    <ProgressBar x:Name="EpochProgress" Value="10" Maximum="100" Style="{StaticResource ProgressBar}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Batch Progress -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="📦" FontSize="20"/>
                    <TextBlock x:Name="BatchValue" Text="1/6" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Current Batch" Style="{StaticResource StatLabel}"/>
                    <ProgressBar x:Name="BatchProgress" Value="17" Maximum="100" Style="{StaticResource ProgressBar}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Images Processed -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="🖼️" FontSize="20"/>
                    <TextBlock x:Name="ImagesValue" Text="45/120" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Images Processed" Style="{StaticResource StatLabel}"/>
                    <ProgressBar x:Name="ImagesProgress" Value="38" Maximum="100" Style="{StaticResource ProgressBar}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Speed -->
            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="⚡" FontSize="20"/>
                    <TextBlock x:Name="SpeedValue" Text="16.2s" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Avg Time/Image" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="ThroughputText" Text="3.7 img/min" Foreground="#00ff88" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- ETA -->
            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="⏱️" FontSize="20"/>
                    <TextBlock x:Name="ETAValue" Text="28:45" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Time Remaining" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="CompletionText" Text="~16:35 completion" Foreground="#888" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel: Detailed Stats -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="📊 Real-Time Training Metrics" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Stats Column -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <!-- Training Stats -->
                                <TextBlock Text="TRAINING" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,10"/>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Rounds" Foreground="#888"/>
                                    <TextBlock x:Name="TotalRounds" Grid.Column="1" Text="30" FontWeight="Bold"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Current Pass" Foreground="#888"/>
                                    <TextBlock x:Name="CurrentPass" Grid.Column="1" Text="1/3 (Foundation)" FontWeight="Bold"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Model Rotations" Foreground="#888"/>
                                    <TextBlock x:Name="ModelRotations" Grid.Column="1" Text="0/15" FontWeight="Bold"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Learning Rate" Foreground="#888"/>
                                    <TextBlock x:Name="LearningRate" Grid.Column="1" Text="1e-4" FontWeight="Bold"/>
                                </Grid>
                                
                                <!-- Quality Stats -->
                                <TextBlock Text="QUALITY DISTRIBUTION" FontWeight="Bold" Foreground="#e94560" Margin="0,20,0,10"/>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⭐ Gold (13-15)" Foreground="#ffd700"/>
                                    <TextBlock x:Name="GoldCount" Grid.Column="1" Text="28 (62%)" FontWeight="Bold" Foreground="#ffd700"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🥈 Silver (10-12)" Foreground="#c0c0c0"/>
                                    <TextBlock x:Name="SilverCount" Grid.Column="1" Text="14 (31%)" FontWeight="Bold" Foreground="#c0c0c0"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🥉 Bronze (6-9)" Foreground="#cd7f32"/>
                                    <TextBlock x:Name="BronzeCount" Grid.Column="1" Text="3 (7%)" FontWeight="Bold" Foreground="#cd7f32"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📁 Archive (0-5)" Foreground="#666"/>
                                    <TextBlock x:Name="ArchiveCount" Grid.Column="1" Text="0 (0%)" FontWeight="Bold" Foreground="#666"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Right Stats Column -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <!-- Performance Stats -->
                                <TextBlock Text="PERFORMANCE" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,10"/>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM Usage" Foreground="#888"/>
                                    <TextBlock x:Name="RAMUsage" Grid.Column="1" Text="58.2 GB" FontWeight="Bold"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU VRAM" Foreground="#888"/>
                                    <TextBlock x:Name="VRAMUsage" Grid.Column="1" Text="11.5 GB" FontWeight="Bold"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAMDrive" Foreground="#888"/>
                                    <TextBlock x:Name="RAMDriveStatus" Grid.Column="1" Text="R: 32GB ✓" FontWeight="Bold" Foreground="#00ff88"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="I/O Speed" Foreground="#888"/>
                                    <TextBlock x:Name="IOSpeed" Grid.Column="1" Text="35,000 MB/s" FontWeight="Bold" Foreground="#00ff88"/>
                                </Grid>
                                
                                <!-- Caption Stats -->
                                <TextBlock Text="CAPTIONING" FontWeight="Bold" Foreground="#e94560" Margin="0,20,0,10"/>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Avg Caption Length" Foreground="#888"/>
                                    <TextBlock x:Name="CaptionLength" Grid.Column="1" Text="342 chars" FontWeight="Bold"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tags/Image" Foreground="#888"/>
                                    <TextBlock x:Name="TagsPerImage" Grid.Column="1" Text="24 avg" FontWeight="Bold"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Consistency Score" Foreground="#888"/>
                                    <TextBlock x:Name="ConsistencyScore" Grid.Column="1" Text="0.31" FontWeight="Bold"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Verified" Foreground="#888"/>
                                    <TextBlock x:Name="VerifiedCount" Grid.Column="1" Text="38/45" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Right Panel: Model & Category Info -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <!-- Current Model -->
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="🤖 Active Model" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="CurrentModel" Text="thesby_Qwen2.5-VL-7B" FontSize="16" Foreground="#00ff88" TextWrapping="Wrap"/>
                        <TextBlock Text="NSFW-Caption-V3" Foreground="#888" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="#333" CornerRadius="4" Padding="8,4" Margin="0,0,5,0">
                                <TextBlock Text="7.87 GB" FontSize="11"/>
                            </Border>
                            <Border Background="#333" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="Vision" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Category Rotation -->
                <Border Style="{StaticResource StatCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="🔄 Category Rotation" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Border Background="#0f3460" CornerRadius="4" Padding="10" Margin="0,5">
                            <StackPanel>
                                <TextBlock Text="Pass 1: Foundation" FontWeight="Bold"/>
                                <TextBlock Text="Rounds 1-10" Foreground="#888" FontSize="11"/>
                                <ProgressBar Value="30" Maximum="100" Style="{StaticResource ProgressBar}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#333" CornerRadius="4" Padding="10" Margin="0,5" Opacity="0.5">
                            <StackPanel>
                                <TextBlock Text="Pass 2: Refinement" FontWeight="Bold"/>
                                <TextBlock Text="Rounds 11-20" Foreground="#888" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#333" CornerRadius="4" Padding="10" Margin="0,5" Opacity="0.5">
                            <StackPanel>
                                <TextBlock Text="Pass 3: Mastery" FontWeight="Bold"/>
                                <TextBlock Text="Rounds 21-30" Foreground="#888" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Batch Queue -->
                <Border Style="{StaticResource StatCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="📦 Batch Queue" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Batch 1 (120 frames)" Foreground="#00ff88"/>
                            <TextBlock Grid.Column="1" Text="🔄 38%" Foreground="#00ff88"/>
                        </Grid>
                        
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Batch 2 (180 frames)" Foreground="#888"/>
                            <TextBlock Grid.Column="1" Text="⏳" Foreground="#888"/>
                        </Grid>
                        
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Batch 3 (420 frames)" Foreground="#666"/>
                            <TextBlock Grid.Column="1" Text="⏳" Foreground="#666"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        
        <!-- Bottom: Live Log -->
        <Border Grid.Row="3" Style="{StaticResource StatCard}" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="📝 Live Activity Log" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <ScrollViewer Grid.Row="1" x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogOutput" FontFamily="Consolas" FontSize="11" Foreground="#aaa" TextWrapping="Wrap">
16:08:05 | [IMG] Processing: Xvideos_ashly_puffy_nipple_masturbation_HD_0012.jpg
16:08:03 | Consistency: 0.33 - Low consistency
16:08:00 | Quality: 10/15 (GOLD)
16:07:58 | Tags: 23 generated
16:07:45 | [OK] Completed in 16.72s
16:07:28 | [IMG] Processing: Xvideos_ashly_puffy_nipple_masturbation_HD_0011.jpg
                    </TextBlock>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
