<Window x:Class="AIStudioDashboard.Views.CountryDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Country Compliance Dashboard" Height="800" Width="1200"
        Background="#1a1a2e" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#252547"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#16213e" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Country Compliance Dashboard" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="197 Countries | Age Restrictions | Content Compliance" 
                               FontSize="12" Foreground="#8892b0" Margin="0,5,0,0"/>
                </StackPanel>
                
                <!-- Country Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Your Country:" Foreground="#8892b0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CountrySelector" Width="200" SelectionChanged="CountrySelector_Changed">
                        <ComboBoxItem Content="United States (US)" Tag="US" IsSelected="True"/>
                        <ComboBoxItem Content="United Kingdom (GB)" Tag="GB"/>
                        <ComboBoxItem Content="Germany (DE)" Tag="DE"/>
                        <ComboBoxItem Content="France (FR)" Tag="FR"/>
                        <ComboBoxItem Content="Japan (JP)" Tag="JP"/>
                        <ComboBoxItem Content="Australia (AU)" Tag="AU"/>
                        <ComboBoxItem Content="Canada (CA)" Tag="CA"/>
                        <ComboBoxItem Content="Netherlands (NL)" Tag="NL"/>
                        <ComboBoxItem Content="Saudi Arabia (SA)" Tag="SA"/>
                        <ComboBoxItem Content="China (CN)" Tag="CN"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Stats Row -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="197" FontSize="36" FontWeight="Bold" Foreground="#64ffda" HorizontalAlignment="Center"/>
                    <TextBlock Text="Total Countries" FontSize="12" Foreground="#8892b0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="45" FontSize="36" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Center"/>
                    <TextBlock Text="Explicit Banned" FontSize="12" Foreground="#8892b0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="11" FontSize="36" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Center"/>
                    <TextBlock Text="Age 21+ Countries" FontSize="12" Foreground="#8892b0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="29" FontSize="36" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                    <TextBlock Text="Rating Systems" FontSize="12" Foreground="#8892b0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            
            <!-- Country Details -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SELECTED COUNTRY DETAILS" FontSize="14" FontWeight="Bold" 
                                   Foreground="#64ffda" Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Country:" Foreground="#8892b0" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CountryName" Text="United States" Foreground="White" FontWeight="Bold" Margin="0,5"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Code:" Foreground="#8892b0" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CountryCode" Text="US" Foreground="White" Margin="0,5"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Rating System:" Foreground="#8892b0" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RatingSystem" Text="MPAA" Foreground="#2196F3" Margin="0,5"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Adult Legal Age:" Foreground="#8892b0" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AdultAge" Text="18" Foreground="#FF9800" FontWeight="Bold" Margin="0,5"/>
                            
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Explicit Status:" Foreground="#8892b0" Margin="0,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ExplicitStatus" Text="Allowed" Foreground="#4CAF50" FontWeight="Bold" Margin="0,5"/>
                            
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Max Rating:" Foreground="#8892b0" Margin="0,5"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="MaxRating" Text="EXTREME" Foreground="#64ffda" FontWeight="Bold" Margin="0,5"/>
                            
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Restrictions:" Foreground="#8892b0" Margin="0,5"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="Restrictions" Text="None" Foreground="White" TextWrapping="Wrap" Margin="0,5"/>
                        </Grid>
                        
                        <Separator Background="#333" Margin="0,20"/>
                        
                        <!-- Age Groups -->
                        <TextBlock Text="AGE OF MAJORITY BY REGION" FontSize="14" FontWeight="Bold" 
                                   Foreground="#64ffda" Margin="0,10,0,15"/>
                        
                        <WrapPanel>
                            <Border Background="#1a472a" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="16+" FontSize="16" FontWeight="Bold" Foreground="#4CAF50"/>
                                    <TextBlock Text="1 country" FontSize="10" Foreground="#8892b0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1a3a5c" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="17+" FontSize="16" FontWeight="Bold" Foreground="#2196F3"/>
                                    <TextBlock Text="1 country" FontSize="10" Foreground="#8892b0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#3d2914" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="18+" FontSize="16" FontWeight="Bold" Foreground="#FF9800"/>
                                    <TextBlock Text="181 countries" FontSize="10" Foreground="#8892b0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#4a1942" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="19+" FontSize="16" FontWeight="Bold" Foreground="#9C27B0"/>
                                    <TextBlock Text="2 countries" FontSize="10" Foreground="#8892b0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#5c1a1a" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="21+" FontSize="16" FontWeight="Bold" Foreground="#F44336"/>
                                    <TextBlock Text="11 countries" FontSize="10" Foreground="#8892b0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Restricted Countries List -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="EXPLICIT BANNED COUNTRIES" FontSize="14" FontWeight="Bold" 
                               Foreground="#F44336" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BannedCountriesList">
                            <!-- Middle East -->
                            <TextBlock Text="Middle East" FontSize="11" Foreground="#FF9800" Margin="0,10,0,5"/>
                            <TextBlock Text="Saudi Arabia (SA)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="UAE (AE)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Qatar (QA)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Kuwait (KW)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Bahrain (BH)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Oman (OM)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Iran (IR)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Iraq (IQ)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Yemen (YE)" Foreground="#8892b0" Margin="10,2"/>
                            
                            <!-- Asia -->
                            <TextBlock Text="Asia" FontSize="11" Foreground="#2196F3" Margin="0,10,0,5"/>
                            <TextBlock Text="China (CN)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="North Korea (KP)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Pakistan (PK)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Bangladesh (BD)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Indonesia (ID)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Malaysia (MY)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Singapore (SG)" Foreground="#8892b0" Margin="10,2"/>
                            
                            <!-- Africa -->
                            <TextBlock Text="Africa" FontSize="11" Foreground="#4CAF50" Margin="0,10,0,5"/>
                            <TextBlock Text="Egypt (EG)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Algeria (DZ)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Morocco (MA)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Tunisia (TN)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Libya (LY)" Foreground="#8892b0" Margin="10,2"/>
                            <TextBlock Text="Sudan (SD)" Foreground="#8892b0" Margin="10,2"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <Separator Background="#333" Margin="0,15"/>
                    
                    <TextBlock Text="COMPLIANCE CHECK" FontSize="12" Foreground="#64ffda" Margin="0,0,0,10"/>
                    <Button Content="Check My Compliance" Background="#2196F3" Foreground="White" 
                            Padding="15,10" Cursor="Hand" Click="CheckCompliance_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
