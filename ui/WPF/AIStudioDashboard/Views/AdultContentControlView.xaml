<Window x:Class="AIStudioDashboard.Views.AdultContentControlView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adult Content &amp; Automation Control" 
        Height="800" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#00d4ff"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#00ff88"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#ffcc00"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#ff6b6b"/>
        <SolidColorBrush x:Key="AdultBrush" Color="#ff4081"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#2a2a4a"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ffffff"/>
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="12"/>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="🔞 ADULT CONTENT &amp; AUTOMATION CONTROL" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="{StaticResource AdultBrush}"/>
                <TextBlock Text="Control age verification, content ratings, and AI automation"
                           Foreground="#888888" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                
                <!-- Age Verification Slider -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🎂 AGE VERIFICATION SLIDER" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <Slider x:Name="AgeSlider" 
                                    Minimum="13" Maximum="65" 
                                    Value="18"
                                    TickFrequency="1" 
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="AgeSlider_ValueChanged"/>
                            
                            <Border Grid.Column="1" Background="#3a3a5a" CornerRadius="8" Padding="12,8" Margin="12,0,0,0">
                                <TextBlock x:Name="AgeDisplay" Text="18" 
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        
                        <!-- Rating Access Display -->
                        <Border Background="#1a1a2e" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Content Access Level:" 
                                           Foreground="#888888" Margin="0,0,0,8"/>
                                <TextBlock x:Name="RatingDisplay" 
                                           Text="PG-13" 
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock x:Name="RatingDescription" 
                                           Text="Teen content allowed"
                                           Foreground="#888888" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Rating Tiers -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Rating Tiers:" Foreground="#888888" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Border x:Name="PGBadge" Background="#2a4a2a" CornerRadius="6" Padding="12,6" Margin="4">
                                    <TextBlock Text="PG (0+)" Foreground="#00ff88"/>
                                </Border>
                                <Border x:Name="PG13Badge" Background="#2a3a4a" CornerRadius="6" Padding="12,6" Margin="4">
                                    <TextBlock Text="PG-13 (13+)" Foreground="#00d4ff"/>
                                </Border>
                                <Border x:Name="RBadge" Background="#3a3a2a" CornerRadius="6" Padding="12,6" Margin="4">
                                    <TextBlock Text="R (17+)" Foreground="#ffcc00"/>
                                </Border>
                                <Border x:Name="NC17Badge" Background="#4a2a2a" CornerRadius="6" Padding="12,6" Margin="4">
                                    <TextBlock Text="NC-17 (18+)" Foreground="#ff9966"/>
                                </Border>
                                <Border x:Name="XBadge" Background="#4a1a2a" CornerRadius="6" Padding="12,6" Margin="4">
                                    <TextBlock Text="X (21+)" Foreground="#ff4081"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Automation Mode -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🤖 AUTOMATION MODE" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                        
                        <StackPanel>
                            <RadioButton x:Name="ManualMode" 
                                         Content="MANUAL - User controls all actions"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontSize="14" Margin="0,8"
                                         Checked="AutomationMode_Changed"/>
                            
                            <RadioButton x:Name="SemiAutoMode" 
                                         Content="SEMI-AUTO - AI assists when stuck"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontSize="14" Margin="0,8"
                                         IsChecked="True"
                                         Checked="AutomationMode_Changed"/>
                            
                            <RadioButton x:Name="FullAutoMode" 
                                         Content="FULL AUTO - AI handles everything"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontSize="14" Margin="0,8"
                                         Checked="AutomationMode_Changed"/>
                        </StackPanel>
                        
                        <Border Background="#1a3a2a" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                            <TextBlock x:Name="AutomationDescription"
                                       Text="AI assists when user gets stuck. Asks for confirmation on major actions."
                                       Foreground="#00ff88" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Pipeline Control -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🚀 PIPELINE CONTROL" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                        
                        <!-- Status -->
                        <Border Background="#1a1a2e" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBlock Text="Pipeline Status:" Foreground="#888888"/>
                                    <TextBlock x:Name="PipelineStatus" Text="IDLE" 
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="Progress:" Foreground="#888888"/>
                                    <TextBlock x:Name="ProgressDisplay" Text="0%" 
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Progress Bar -->
                        <ProgressBar x:Name="PipelineProgress" 
                                     Height="8" 
                                     Value="0" Maximum="100"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     Background="#1a1a2e"/>
                        
                        <!-- Image Counts -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Generated" Foreground="#888888" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="GeneratedCount" Text="0" 
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Failed" Foreground="#888888" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FailedCount" Text="0" 
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource ErrorBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="AI Fixes" Foreground="#888888" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="AIFixesCount" Text="0" 
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Control Buttons -->
                        <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                            <Button x:Name="StartButton" Content="▶ START" 
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource SuccessBrush}"
                                    Click="StartPipeline_Click"/>
                            <Button x:Name="PauseButton" Content="⏸ PAUSE" 
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource WarningBrush}"
                                    Click="PausePipeline_Click"/>
                            <Button x:Name="StopButton" Content="⏹ STOP" 
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource ErrorBrush}"
                                    Click="StopPipeline_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                
                <!-- Generation Settings -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="⚙️ GENERATION SETTINGS" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Total Images:" Foreground="#888888"/>
                                <TextBox x:Name="TotalImagesInput" Text="300" 
                                         Background="#1a1a2e" Foreground="White"
                                         FontSize="16" Padding="12"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Adult Ratio (%):" Foreground="#888888"/>
                                <TextBox x:Name="AdultRatioInput" Text="83" 
                                         Background="#1a1a2e" Foreground="White"
                                         FontSize="16" Padding="12"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Margin="0,8,8,0">
                                <TextBlock Text="Dwelling:" Foreground="#888888"/>
                                <ComboBox x:Name="DwellingSelect" 
                                          Background="#1a1a2e" Foreground="White"
                                          FontSize="16" Padding="8">
                                    <ComboBoxItem Content="Teepee" IsSelected="True"/>
                                    <ComboBoxItem Content="Earth Lodge"/>
                                    <ComboBoxItem Content="Wickiup"/>
                                    <ComboBoxItem Content="Longhouse"/>
                                    <ComboBoxItem Content="Frontier Cabin"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                                <TextBlock Text="Stuck Timeout (sec):" Foreground="#888888"/>
                                <TextBox x:Name="StuckTimeoutInput" Text="30" 
                                         Background="#1a1a2e" Foreground="White"
                                         FontSize="16" Padding="12"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
