<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Card Style -->
    <Style x:Key="DashboardCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="8" />
    </Style>
    
    <!-- Status Card Style -->
    <Style x:Key="StatusCard" TargetType="Border" BasedOn="{StaticResource DashboardCard}">
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="MinHeight" Value="80" />
    </Style>
    
    <!-- Section Header -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    
    <!-- Card Title -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    
    <!-- Card Value -->
    <Style x:Key="CardValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <!-- Small Value -->
    <Style x:Key="SmallValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    
    <!-- Status Indicator -->
    <Style x:Key="StatusIndicator" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    
    <!-- Online Indicator -->
    <Style x:Key="OnlineIndicator" TargetType="Ellipse" BasedOn="{StaticResource StatusIndicator}">
        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
    </Style>
    
    <!-- Offline Indicator -->
    <Style x:Key="OfflineIndicator" TargetType="Ellipse" BasedOn="{StaticResource StatusIndicator}">
        <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
    </Style>
    
    <!-- Progress Bar Style -->
    <Style x:Key="DashboardProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>
    
    <!-- Action Button -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="4" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- Model Grade Styles -->
    <Style x:Key="GradeS" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    
    <Style x:Key="GradeA" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    
    <Style x:Key="GradeB" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    
</ResourceDictionary>
