<Window x:Class="AIStudioDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AIStudioDashboard.ViewModels"
        mc:Ignorable="d"
        Title="MediaForge Dashboard" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🎨" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="MEDIAFORGE DASHBOARD" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" 
                             Fill="{StaticResource SuccessBrush}" 
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="LIVE" 
                               Foreground="{StaticResource SuccessBrush}"
                               FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- System Status Cards -->
                <Border Grid.Row="0" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="📊 SYSTEM STATUS" Style="{StaticResource SectionHeader}" />
                        <WrapPanel>
                            <!-- LM Studio Status -->
                            <Border Style="{StaticResource StatusCard}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="LM STUDIO" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" 
                                                 Fill="{Binding SystemHealth.LMStudioOnline, Converter={StaticResource BoolToColorConverter}}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SystemHealth.LMStudioOnline, Converter={StaticResource BoolToStatusConverter}}" 
                                                   Style="{StaticResource CardValue}" FontSize="16" />
                                    </StackPanel>
                                    <TextBlock Text="Port 1234" Style="{StaticResource SmallValue}" />
                                </StackPanel>
                            </Border>
                            
                            <!-- Ollama Status -->
                            <Border Style="{StaticResource StatusCard}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="OLLAMA" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" 
                                                 Fill="{Binding SystemHealth.OllamaOnline, Converter={StaticResource BoolToColorConverter}}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SystemHealth.OllamaOnline, Converter={StaticResource BoolToStatusConverter}}" 
                                                   Style="{StaticResource CardValue}" FontSize="16" />
                                    </StackPanel>
                                    <TextBlock Text="Port 11434" Style="{StaticResource SmallValue}" />
                                </StackPanel>
                            </Border>
                            
                            <!-- GPU Usage -->
                            <Border Style="{StaticResource StatusCard}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="GPU USAGE" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding SystemHealth.GpuUsage, StringFormat={}{0:F0}%}" 
                                               Style="{StaticResource CardValue}" />
                                    <ProgressBar Value="{Binding SystemHealth.GpuUsage}" Maximum="100" 
                                                 Height="6" Margin="0,8,0,0" 
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 Foreground="{StaticResource PrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            
                            <!-- Memory -->
                            <Border Style="{StaticResource StatusCard}">
                                <StackPanel>
                                    <TextBlock Text="VRAM" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardValue}">
                                        <Run Text="{Binding SystemHealth.MemoryUsageGB, StringFormat={}{0:F1}}" />
                                        <Run Text=" GB" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </TextBlock>
                                    <ProgressBar Value="{Binding SystemHealth.MemoryUsagePercent}" Maximum="100" 
                                                 Height="6" Margin="0,8,0,0" 
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 Foreground="{StaticResource InfoBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                
                <!-- Video Processing + Current Task -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Video Processing Stats -->
                    <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="📹 VIDEO PROCESSING" Style="{StaticResource SectionHeader}" />
                            
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Total Videos" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding VideoStats.TotalVideos}" Style="{StaticResource CardValue}" />
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Processed" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VideoStats.ProcessedVideos}" Style="{StaticResource CardValue}" />
                                        <TextBlock Text="{Binding VideoStats.ProgressPercent, StringFormat=' ({0:F0}%)'}" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                    </StackPanel>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="0" Grid.Row="1">
                                    <TextBlock Text="Approved" Style="{StaticResource CardTitle}" />
                                    <TextBlock Foreground="{StaticResource SuccessBrush}">
                                        <Run Text="{Binding VideoStats.ApprovedVideos}" FontSize="24" FontWeight="Bold" />
                                        <Run Text="{Binding VideoStats.ApprovalRate, StringFormat=' ({0:F0}%)'}" FontSize="14" />
                                    </TextBlock>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Grid.Row="1">
                                    <TextBlock Text="Rejected" Style="{StaticResource CardTitle}" />
                                    <TextBlock Foreground="{StaticResource ErrorBrush}">
                                        <Run Text="{Binding VideoStats.RejectedVideos}" FontSize="24" FontWeight="Bold" />
                                        <Run Text="{Binding VideoStats.RejectionRate, StringFormat=' ({0:F0}%)'}" FontSize="14" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            
                            <ProgressBar Value="{Binding VideoStats.ProgressPercent}" Maximum="100" 
                                         Height="8" Margin="0,0,0,16"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="{StaticResource PrimaryBrush}" />
                            
                            <!-- Rejection Reasons -->
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="REJECTION REASONS" Style="{StaticResource CardTitle}" />
                                    <ItemsControl ItemsSource="{Binding VideoStats.RejectionReasons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Current Task -->
                    <Border Grid.Column="1" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="🎯 CURRENT TASK" Style="{StaticResource SectionHeader}" />
                            
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Stage" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding CurrentTask.Stage}" 
                                           Style="{StaticResource CardValue}" 
                                           Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                            
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Video" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding CurrentTask.VideoName}" 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Frame" Style="{StaticResource CardTitle}" />
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{Binding CurrentTask.CurrentFrame}" FontWeight="Bold" />
                                        <Run Text="/" />
                                        <Run Text="{Binding CurrentTask.TotalFrames}" />
                                    </TextBlock>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Time" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding CurrentTask.ProcessingTime, StringFormat={}{0:F1}s}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                            
                            <!-- Last Analysis -->
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="LAST ANALYSIS" Style="{StaticResource CardTitle}" />
                                    
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Grid.Row="0">
                                            <Run Text="Gender: " Foreground="{StaticResource TextMutedBrush}" />
                                            <Run Text="{Binding CurrentTask.LastAnalysis.Gender}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </TextBlock>
                                        
                                        <TextBlock Grid.Column="1" Grid.Row="0">
                                            <Run Text="Body: " Foreground="{StaticResource TextMutedBrush}" />
                                            <Run Text="{Binding CurrentTask.LastAnalysis.BodyType}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </TextBlock>
                                        
                                        <TextBlock Grid.Column="0" Grid.Row="1" Margin="0,4,0,0">
                                            <Run Text="Quality: " Foreground="{StaticResource TextMutedBrush}" />
                                            <Run Text="{Binding CurrentTask.LastAnalysis.Quality}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </TextBlock>
                                        
                                        <TextBlock Grid.Column="1" Grid.Row="1" Margin="0,4,0,0">
                                            <Run Text="Attract: " Foreground="{StaticResource TextMutedBrush}" />
                                            <Run Text="{Binding CurrentTask.LastAnalysis.Attractiveness}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </TextBlock>
                                        
                                        <TextBlock Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                            <Run Text="Status: " Foreground="{StaticResource TextMutedBrush}" />
                                            <Run Text="✓ APPROVED" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" />
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Model Versions Comparison -->
                <Border Grid.Row="2" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="📈 MODEL VERSIONS COMPARISON" Style="{StaticResource SectionHeader}" />
                        
                        <DataGrid ItemsSource="{Binding ModelVersions}" 
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowBackground="{StaticResource SurfaceBrush}"
                                  AlternatingRowBackground="{StaticResource SurfaceAltBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VERSION" Binding="{Binding Name}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="AESTHETIC" Binding="{Binding AestheticScore, StringFormat={}{0:F1}}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="ACCURACY" Binding="{Binding AccuracyRate, StringFormat={}{0:F0}%}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="QUALITY" Binding="{Binding QualityScore, StringFormat={}{0:F1}}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="GRADE" Binding="{Binding OverallGrade}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                
                <!-- Sample Preview Grid -->
                <Border Grid.Row="3" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="🖼️ RECENT FRAMES" Style="{StaticResource SectionHeader}" />
                        
                        <ItemsControl ItemsSource="{Binding RecentFrames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="100" Height="100" Margin="4"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Approved, Converter={StaticResource BoolToApprovalConverter}}"
                                                           FontSize="24" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding VideoName}" 
                                                           FontSize="9" 
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="90" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Quality, StringFormat=Q:{0}}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Left"
                                                       Margin="4" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <!-- Quick Actions -->
                <Border Grid.Row="4" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="⚡ QUICK ACTIONS" Style="{StaticResource SectionHeader}" />
                        
                        <WrapPanel>
                            <Button Style="{StaticResource ActionButton}" 
                                    Command="{Binding StartFilteringCommand}"
                                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" Margin="0,0,8,0" />
                                    <TextBlock Text="Start Filter" />
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource ActionButton}" 
                                    Command="{Binding PauseFilteringCommand}"
                                    Background="{StaticResource WarningBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏸" Margin="0,0,8,0" />
                                    <TextBlock Text="Pause" />
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource ActionButton}" 
                                    Command="{Binding StopFilteringCommand}"
                                    Background="{StaticResource ErrorBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏹" Margin="0,0,8,0" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource ActionButton}" 
                                    Command="{Binding OpenFoldersCommand}"
                                    Background="{StaticResource SurfaceAltBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" Margin="0,0,8,0" />
                                    <TextBlock Text="Open Folders" />
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource ActionButton}" 
                                    Command="{Binding OpenSettingsCommand}"
                                    Background="{StaticResource SurfaceAltBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" Margin="0,0,8,0" />
                                    <TextBlock Text="Settings" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center">
                    <Run Text="STATUS: " />
                    <Run Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Run Text=" | Processing video " />
                    <Run Text="{Binding VideoStats.ProcessedVideos}" />
                    <Run Text="/" />
                    <Run Text="{Binding VideoStats.TotalVideos}" />
                    <Run Text=" | Approved: " />
                    <Run Text="{Binding VideoStats.ApprovedVideos}" Foreground="{StaticResource SuccessBrush}" />
                    <Run Text=" | Speed: " />
                    <Run Text="{Binding SystemHealth.ProcessingSpeedSeconds, StringFormat={}{0:F1}s/frame}" />
                </TextBlock>
                
                <TextBlock Grid.Column="1" 
                           Text="{Binding SystemHealth.LastUpdate, StringFormat=Last update: {0:HH:mm:ss}}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
